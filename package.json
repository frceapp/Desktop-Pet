{
  "name": "desktop-pet",
  "productName": "Desktop Pet",
  "version": "1.0.3",
  "description": "Chiikawa, Hachiware and Usagi walking around on top of your windows",
  "author": "Lim",
  "repository": "github:frceapp/Desktop-Pet",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.frceapp.desktoppet",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "preload-effect.js",
      "renderer/**",
      "characters/**",
      "chiikawa_and_friends/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Desktop-Pet-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1"
  }
}
